# Copy to .env.local and fill in. Never commit real values.

# Supabase (Phase 5) — Supabase dashboard > Project Settings > API.
# In production, set these in Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Offline materials pipeline only (Phase 6, scripts/). Never prefix with NEXT_PUBLIC_,
# never add to Vercel — the deployed game must not call these.
# SerpAPI: serpapi.com > Dashboard > API Key. Gemini: aistudio.google.com > Get API key.
SERPAPI_API_KEY=
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.1-flash-lite, the cheapest that works). Changing it
# makes cached estimates stale, so the next run pays again. Leave unset unless you mean it.
# GEMINI_MODEL=

# Dev only: add the FAKE items from `npm run materials:mock` to the game (and run it offline,
# without Supabase, so fake items never reach the shared database). Ignored in production.
# NEXT_PUBLIC_MOCK_ITEMS=1
