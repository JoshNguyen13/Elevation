# Copy to .env.local and fill in. Never commit real values.

# Supabase (Phase 5) — Supabase dashboard > Project Settings > API.
# In production, set these in Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Offline materials pipeline only (Phase 6, scripts/). Never prefix with NEXT_PUBLIC_,
# never add to Vercel — the deployed game must not call these.
# SerpAPI: serpapi.com > Dashboard > API Key. Gemini: aistudio.google.com > Get API key.
SERPAPI_API_KEY=
GEMINI_API_KEY=
