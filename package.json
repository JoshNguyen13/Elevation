{
  "name": "elevation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "materials:plan": "node --env-file-if-exists=.env.local scripts/materials/generate.mjs",
    "materials:run": "node --env-file-if-exists=.env.local scripts/materials/generate.mjs --run",
    "materials:rebuild": "node scripts/materials/generate.mjs --rebuild",
    "materials:mock": "node scripts/materials/generate.mjs --mock",
    "materials:check": "node scripts/materials/check.mjs",
    "materials:test": "node --test scripts/materials/*.test.mjs",
    "par:merge": "node scripts/par/merge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "matter-js": "^0.20.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  }
}
