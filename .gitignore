# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# materials pipeline: reference photos from SerpAPI are not ours to commit.
# (scripts/cache/serpapi, gemini and ledger.jsonl ARE committed, so teammates never pay twice.)
/scripts/cache/images/
*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
